{
  "manifest_version": 2,
  "name": "TabTools - Close & Sort Tabs by Site",
  "version": "4.0.2",
  "description": "Close tabs from the same website, sort tabs by site and remove duplicates to keep your browser organised.",
  "author": "Michael Wester",
  "homepage_url": "https://tabtools.fyi/",
  "permissions": ["tabs", "storage", "contextMenus"],
  "background": { "scripts": ["background.js", "background.suggestions.js"] },
  "browser_action": {
    "default_title": "Open TabTools",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/black/icon-16.png",
      "32": "icons/black/icon-32.png"
    },
    "theme_icons": [
      {
        "light": "icons/white/icon-16.png",
        "dark": "icons/black/icon-16.png",
        "size": 16
      },
      {
        "light": "icons/white/icon-32.png",
        "dark": "icons/black/icon-32.png",
        "size": 32
      }
    ]
  },
  "icons": {
    "16": "icons/tabtools-icon-auto.svg",
    "32": "icons/tabtools-icon-auto.svg",
    "48": "icons/tabtools-icon-auto.svg",
    "96": "icons/tabtools-icon-auto.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabtools@michaelwester.com",
      "strict_min_version": "78.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
