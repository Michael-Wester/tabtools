{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "4.0.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Michael Wester",
  "homepage_url": "https://github.com/Michael-Wester/tabtools",
  "permissions": ["tabs", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_openTabTools__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/black/icon-16.png",
      "32": "icons/black/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/black/icon-16.png",
    "32": "icons/black/icon-32.png",
    "48": "icons/black/icon-48.png",
    "128": "icons/black/icon-128.png"
  }
}
